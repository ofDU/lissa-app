{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "jekyll serve",
      "type": "shell",
      "command": "$HOME/.asdf/shims/bundle",
      "args": ["exec", "jekyll", "serve", "--livereload"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Prettier: Format Current File",
      "type": "shell",
      "command": "npx",
      "args": ["prettier", "${file}", "--write"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      }
    }
  ]
}
